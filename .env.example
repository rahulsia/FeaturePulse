POSTGRES_PASSWORD=change-this-to-a-strong-random-password
PORT=8080
# Required when running via docker-compose (that path is reachable beyond just your own
# machine). Optional for `uvicorn` run directly for local-only development.
# Production still requires real SSO/authorization and HTTPS on top of this.
API_TOKEN=

# Optional: Host headers the backend will accept, comma-separated (defense against DNS
# rebinding). Defaults to localhost,127.0.0.1,testserver if unset.
ALLOWED_HOSTS=

# Optional: restrict which hosts authored UI tests are allowed to navigate to.
# Comma-separated, supports *.domain wildcards. Empty = unrestricted (dev default).
ALLOWED_TEST_HOSTS=

# Optional: JIRA integration for "Will Fix Later" feedback.
# Leave all blank to disable. Set all four to enable real ticket creation via
# JIRA's REST API (Basic Auth with an API token — never your account password).
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Optional overrides:
JIRA_ISSUE_TYPE=Bug
# '3' = Jira Cloud (default). Use '2' for Jira Server / Data Center.
JIRA_API_VERSION=3
